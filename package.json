{
  "name": "idle-awakening",
  "version": "1.0.1",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "webpack serve --config webpack.config.js",
    "start:demo": "set IS_DEMO=1 && webpack serve --config webpack.config.js",
    "build": "npm update & webpack --config webpack.config.js",
    "build:demo": "set IS_DEMO=1 & webpack --config webpack.config.js",
    "electron:dev": "electron electron/main.js",
    "electron:build": "npm update & webpack --config webpack.config.js & electron-builder",
    "electron:demo-build": "set IS_DEMO=1 & set IS_STEAM_BUILD=1 & npm update & webpack --config webpack.config.js & electron-builder"
  },
  "build": {
    "appId": "com.example.mygame",
    "productName": "IdleAwakening",
    "directories": {
      "output": "exec"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "win": {
      "target": "nsis",
      "icon": "public/favico.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icons/"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@babel/core": "^7.24.7",
    "@babel/plugin-proposal-logical-assignment-operators": "^7.20.7",
    "@babel/preset-env": "^7.24.7",
    "@babel/preset-react": "^7.24.7",
    "babel-loader": "^9.1.3",
    "copy-webpack-plugin": "^12.0.2",
    "cross-env": "^7.0.3",
    "css-loader": "^7.1.2",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "file-loader": "^6.2.0",
    "game-framework": "git+https://github.com/olegbugaenko/game-framework.git#main",
    "html-webpack-plugin": "^5.6.0",
    "style-loader": "^4.0.0",
    "url-loader": "^4.1.1",
    "webpack": "^5.92.1",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.4",
    "worker-loader": "^3.0.8"
  },
  "dependencies": {
    "@dnd-kit/accessibility": "^3.1.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@tippyjs/react": "^4.2.6",
    "lodash": "^4.17.21",
    "react": "^18.3.1",
    "react-beautiful-dnd": "^13.1.1",
    "react-dom": "^18.3.1",
    "react-joyride": "^2.9.3",
    "react-perfect-scrollbar": "^1.5.8",
    "react-select": "^5.8.1",
    "react-tippy": "^1.4.0",
    "recharts": "^2.13.3"
  }
}
